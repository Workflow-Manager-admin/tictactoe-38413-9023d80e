<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="@color/primary"
    android:layout_height="match_parent">

    <!-- Player Turn Indicator -->
    <TextView
        android:id="@+id/player_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Turn: X"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="22sp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toTopOf="@+id/tictactoe_grid"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        />

    <!-- TicTacToe Grid -->
    <GridLayout
        android:id="@+id/tictactoe_grid"
        android:layout_width="min(98vw,420dp)"
        android:layout_height="min(98vw,420dp)"
        android:layout_gravity="center"
        android:alignmentMode="alignMargins"
        android:columnCount="3"
        android:rowCount="3"
        android:background="@android:color/transparent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/player_indicator"
        app:layout_constraintBottom_toTopOf="@+id/reset_button"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="36dp">
        <!-- 3x3 grid; each cell is a Button -->
        <Button
            android:id="@+id/btn_00"
            style="@style/TicTacToeCell"/>
        <Button
            android:id="@+id/btn_01"
            style="@style/TicTacToeCell"/>
        <Button
            android:id="@+id/btn_02"
            style="@style/TicTacToeCell"/>
        <Button
            android:id="@+id/btn_10"
            style="@style/TicTacToeCell"/>
        <Button
            android:id="@+id/btn_11"
            style="@style/TicTacToeCell"/>
        <Button
            android:id="@+id/btn_12"
            style="@style/TicTacToeCell"/>
        <Button
            android:id="@+id/btn_20"
            style="@style/TicTacToeCell"/>
        <Button
            android:id="@+id/btn_21"
            style="@style/TicTacToeCell"/>
        <Button
            android:id="@+id/btn_22"
            style="@style/TicTacToeCell"/>
    </GridLayout>

    <!-- Reset Button -->
    <Button
        android:id="@+id/reset_button"
        android:layout_width="min(48vw,180dp)"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="44dp"
        android:text="Reset"
        android:backgroundTint="@color/accent"
        android:textColor="@color/primary"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:elevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/tictactoe_grid"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
